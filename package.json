{
  "name": "mini-agent-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test test/**/*.test.ts",
    "demo": "tsx src/demo/openai-demo.ts",
    "demo:runtime": "tsx src/demo/runtime-demo.ts",
    "demo:tools": "tsx src/demo/tool-runtime-demo.ts",
    "demo:approval": "tsx src/demo/approval-demo.ts",
    "demo:recovery": "tsx src/demo/conversation-recovery-demo.ts",
    "typecheck:tests": "tsc --noEmit --target ES2022 --module NodeNext --moduleResolution NodeNext --allowImportingTsExtensions --strict --noUncheckedIndexedAccess --exactOptionalPropertyTypes --skipLibCheck test/*.test.ts test/support/*.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "better-sqlite3": "11.10.0",
    "dotenv": "^17.4.2",
    "openai": "^5.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  }
}
